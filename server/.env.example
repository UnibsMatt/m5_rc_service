# Copy to .env and adjust.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gwfleet
POSTGRES_USER=gwfleet

# dashboard:  http://<host>:WEB_PORT
WEB_PORT=8090
# gateways:   API_URL=https://<host>:INGEST_PORT/api/v1/reports
INGEST_PORT=8443

# verified: client cert must chain to certs/client-ca.crt (production: iotplt Root CA)
# present:  any client cert is accepted and recorded (until the iotplt CA is available)
# off:      no client cert needed (testing only)
CLIENT_CERT_POLICY=verified
# off | warn | enforce: report gateway_id must equal the client cert CN
CN_MATCH=warn
# a gateway is offline after this many seconds without a report (~3x INTERVAL_SECS)
ONLINE_AFTER_SECS=90
RETENTION_DAYS=14
